{
    "private": true,
    "version": "0.0.0",
    "name": "webcasa",
    "author": "@juzybits (https://polymedia.app)",
    "homepage": "https://webcasa.polymedia.app",
    "description": "WebCasa is a browser wallet for webcash",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/juzybits/webcasa"
    },
    "keywords": [],
    "scripts": {
        "build": "vite build",
        "clean": "rm -rf dist/ node_modules/ .turbo/ .wrangler/",
        "deploy-dev": "pnpm build && wrangler pages deploy dist/ --project-name polymedia-webcasa --branch dev",
        "deploy-prod": "pnpm build && wrangler pages deploy dist/ --project-name polymedia-webcasa --branch main",
        "dev": "vite",
        "host": "vite --host",
        "lint": "eslint src/ --report-unused-disable-directives --max-warnings 0",
        "preview": "pnpm build && vite preview",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "crypto-js": "^4.2.0",
        "qrcode": "^1.5.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "webcash": "^1.0.6"
    },
    "devDependencies": {
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react-swc": "^3.8.0",
        "less": "^4.2.2",
        "typescript": "^5.7.3",
        "vite": "^6.1.0",
        "wrangler": "^3.109.1"
    },
    "targets": {
        "firebase": {
            "sourceMap": false
        },
        "bundle": {
            "publicUrl": "./",
            "sourceMap": false
        }
    },
    "type": "module",
    "sideEffects": false,
    "packageManager": "pnpm@10.2.0"
}
